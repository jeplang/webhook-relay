# Local development .env file
# Copy this file to .env if you need to override any defaults for local development
# Never commit .env to version control - it's for local development only

# Required: Database connection
RELAY_DATABASE_URL=postgres://relay:relay@localhost:5432/relay?sslmode=disable

# Optional: Override any of the following defaults (see config.go for all options)
# RELAY_HTTP_ADDR=:8080                    # HTTP server address
# RELAY_WORKER_BATCH=50                   # Worker batch size
# RELAY_WORKER_INTERVAL=1s               # Worker poll interval
# RELAY_STALE_IN_FLIGHT=5m                # Stale in-flight window
# RELAY_HTTP_TIMEOUT=10s                  # HTTP client timeout
# RELAY_LOG_LEVEL=info                    # Logging level (debug, info, warn, error)